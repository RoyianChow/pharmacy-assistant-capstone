{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Private image registry for the prescription research classifier.",
  "Parameters": {
    "FunctionName": {
      "Type": "String",
      "Default": "pharmacy-prescription-classifier",
      "AllowedPattern": "[a-zA-Z0-9_-]{1,64}"
    }
  },
  "Resources": {
    "Registry": {
      "Type": "AWS::ECR::Repository",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "ImageTagMutability": "IMMUTABLE",
        "EncryptionConfiguration": {
          "EncryptionType": "AES256"
        },
        "ImageScanningConfiguration": {
          "ScanOnPush": true
        },
        "RepositoryPolicyText": {
          "Version": "2012-10-17",
          "Statement": [{
            "Sid": "LambdaImageRetrieval",
            "Effect": "Allow",
            "Principal": { "Service": "lambda.amazonaws.com" },
            "Action": ["ecr:BatchGetImage", "ecr:GetDownloadUrlForLayer"],
            "Condition": {
              "ArnLike": {
                "aws:SourceArn": { "Fn::Sub": "arn:${AWS::Partition}:lambda:${AWS::Region}:${AWS::AccountId}:function:${FunctionName}" }
              }
            }
          }]
        }
      }
    }
  },
  "Outputs": {
    "RepositoryUri": {
      "Value": {
        "Fn::GetAtt": [
          "Registry",
          "RepositoryUri"
        ]
      }
    },
    "RepositoryName": {
      "Value": {
        "Ref": "Registry"
      }
    }
  }
}
