# Planned local SQLite file location. Do not commit the database file.
DATABASE_PATH=./data/pharmacy-assistant.sqlite

# Hosted dashboard: connect Neon/PostgreSQL in Vercel Storage to set DATABASE_URL.
# Required on Vercel. Leave blank locally to use SQLite. Keep credentials server-only.
# NEON_DB and POSTGRES_URL are accepted aliases. Never use a NEXT_PUBLIC_ name.
DATABASE_URL=

# Staff sign-in: Neon deploy supplies the Auth URL. Generate your own 32+ character
# cookie secret; set these values in Vercel Production as well as .env.local.
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
# Comma-separated verified staff emails. Registering an account alone grants no access.
PHARMACY_STAFF_EMAILS=

# Local demo dashboard only (created automatically when no PostgreSQL URL is set).
PHARMACY_DATABASE_PATH=./data/pharmacy-dashboard.sqlite

# Copy to .env.local. Leave blank for the guided demo; never use NEXT_PUBLIC_ for secrets.
# Obtain the key from the official TypeSafe console: https://console.typesafe.ai
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-1.13.0
